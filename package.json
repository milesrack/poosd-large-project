{
  "name": "zetafly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12 <25"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server/index.ts",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "build": "tsc --project tsconfig.json && npm run build --workspace web",
    "test": "node --test tests/*.test.ts",
    "model:inspect": "node server/brain/weights.ts",
    "model:fetch": "node scripts/fetch-model.ts",
    "setup": "node scripts/setup-env.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "check": "npm run format:check && npm run lint && node scripts/api-contract.ts && npm test && npm run build",
    "sequence:train": "node scripts/train-sequence.ts",
    "api:sync": "node scripts/sync-swaggerhub.ts",
    "model:predict": "node scripts/predict-model.ts",
    "model:anatomy": "node scripts/prepare-anatomy.ts",
    "test:integration": "node scripts/verify-accounts.ts && node scripts/verify-weight-search.ts && npm run test:deletion && npm run test:security",
    "test:deletion": "docker compose exec -T -w /app/server -e RESEND_API_KEY= app node --input-type=module-typescript < scripts/verify-account-deletion.ts",
    "test:security": "docker compose exec -T -w /app/server -e RESEND_API_KEY= app node --input-type=module-typescript < scripts/verify-auth-security.ts",
    "test:simulator": "node scripts/verify-simulator.ts",
    "test:e2e": "node scripts/verify-sound.ts && node scripts/verify-auth-ui.ts && node scripts/verify-playback.ts"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "1.7.10",
    "@noble/hashes": "2.4.0",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-en": "4.1.1",
    "better-auth": "1.7.10",
    "express": "5.3.0",
    "fflate": "0.8.3",
    "helmet": "8.3.0",
    "hyparquet": "1.31.4",
    "hyparquet-compressors": "1.1.2",
    "mongodb": "7.7.0",
    "playwright": "1.64.1",
    "ws": "8.22.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.15",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "openapi-types": "12.1.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
